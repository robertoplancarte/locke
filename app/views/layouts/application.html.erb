<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900">
    <% if current_tenant %>
      <header class="bg-brand-secondary text-brand-secondary-foreground">
        <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-8 gap-y-2 px-4 py-3">
          <%= link_to root_path, class: "flex items-center gap-3 font-semibold" do %>
            <% if current_tenant.logo.attached? %>
              <%= image_tag current_tenant.logo, alt: "", class: "h-8 w-auto" %>
            <% end %>
            <span><%= current_tenant.name %></span>
          <% end %>

          <nav class="flex gap-5 text-sm">
            <%= link_to "Branding", edit_settings_branding_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Domains", settings_domains_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Authentication", edit_settings_authentication_path, class: "opacity-80 hover:opacity-100" %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-4xl px-4 py-10">
      <%= render "application/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
