<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900" data-theme="<%= current_theme %>">
    <% if current_tenant %>
      <%# The border separates the header from the page when the brand color is as dark as dark mode %>
      <header class="bg-brand-secondary text-brand-secondary-foreground dark:border-b dark:border-gray-200">
        <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-8 gap-y-2 px-4 py-3">
          <%= link_to root_path, class: "flex items-center gap-3 font-semibold" do %>
            <% if current_tenant.logo.attached? %>
              <%= image_tag current_tenant.logo, alt: "", class: "h-8 w-auto" %>
            <% end %>
            <span><%= current_tenant.name %></span>
          <% end %>

          <nav class="flex gap-5 text-sm">
            <%= link_to "Branding", edit_settings_branding_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Domains", settings_domains_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Authentication", edit_settings_authentication_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Identity providers", settings_identity_providers_path, class: "opacity-80 hover:opacity-100" %>
            <%= link_to "Apps", settings_applications_path, class: "opacity-80 hover:opacity-100" %>
          </nav>

          <%= render "account_menu" if Current.user %>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-4xl px-4 py-10">
      <%= render "application/flash" %>
      <%= content_for?(:content) ? yield(:content) : yield %>
    </main>
  </body>
</html>
