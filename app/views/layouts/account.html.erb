<%# The account pages: a section sidebar beside the page, inside the application layout %>
<% sections = [
     [ "General", account_path, "accounts",
       "M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" ],
     [ "Security", account_security_path, "accounts/securities",
       "M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a7.464 7.464 0 0 1-1.15 3.993m1.989 3.559A11.209 11.209 0 0 0 8.25 10.5a3.75 3.75 0 1 1 7.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 0 1-3.6 9.75m6.633-4.596a18.666 18.666 0 0 1-2.485 5.33" ],
     [ "Activity", account_activity_path, "accounts/activities",
       "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" ]
   ] %>

<% content_for :content do %>
  <h1 class="sr-only">Account</h1>

  <div class="lg:flex lg:gap-x-12">
    <aside class="-mx-4 flex overflow-x-auto border-b border-gray-200 px-4 pb-4 lg:mx-0 lg:block lg:w-48 lg:flex-none lg:border-0 lg:px-0 lg:pb-0">
      <nav aria-label="Account">
        <ul role="list" class="flex gap-x-3 gap-y-1 whitespace-nowrap lg:flex-col">
          <% sections.each do |label, path, section_controller, icon| %>
            <% current = controller_path == section_controller %>
            <li>
              <%= link_to path, aria: { current: (current ? "page" : nil) },
                    class: [ "group flex gap-x-3 rounded-md py-2 pr-3 pl-2 text-sm/6 font-semibold",
                             current ? "bg-gray-100 text-brand-primary-text" : "text-gray-700 hover:bg-gray-100 hover:text-brand-primary-text" ] do %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                     class="<%= class_names("size-6 shrink-0", current ? "text-brand-primary-text" : "text-gray-400 group-hover:text-brand-primary-text") %>">
                  <path d="<%= icon %>" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <%= label %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </nav>
    </aside>

    <div class="min-w-0 space-y-16 pt-10 lg:flex-auto lg:pt-0">
      <%= yield %>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
