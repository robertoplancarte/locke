<% content_for :title, "Activity · #{current_tenant.name}" %>

<%= render layout: "accounts/section", locals: { title: "Devices and sessions", description: "Where you're signed in. Log out of any you don't recognize.", list: :ul } do %>
  <% @sessions.each do |session| %>
    <li id="<%= dom_id session %>" class="flex items-center justify-between gap-x-6 py-6">
      <div class="min-w-0">
        <p class="truncate font-medium text-gray-900" title="<%= session.user_agent %>"><%= session.user_agent.presence || "Unknown device" %></p>
        <p class="mt-1 text-gray-500"><%= session.ip_address %> · signed in <%= time_ago_in_words(session.created_at) %> ago</p>
      </div>
      <% if session == Current.session %>
        <span class="shrink-0 rounded bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">This device</span>
      <% else %>
        <%= button_to "Log out", session, method: :delete, form_class: "shrink-0",
              class: "cursor-pointer font-semibold text-brand-primary-text hover:opacity-80" %>
      <% end %>
    </li>
  <% end %>
<% end %>

<%= render layout: "accounts/section", locals: {
      title: "Recent activity", description: "Sign-ins and changes to your account.", list: :ul,
      footer: link_to("View full activity log", authentications_events_path, class: "font-semibold text-brand-primary-text hover:opacity-80") } do %>
  <% @events.each do |event| %>
    <li id="<%= dom_id event %>" class="flex justify-between gap-x-6 py-6">
      <div class="font-medium text-gray-900"><%= event.action.humanize %></div>
      <div class="text-right text-gray-500">
        <time datetime="<%= event.created_at.iso8601 %>" title="<%= l event.created_at, format: :long %>"><%= time_ago_in_words(event.created_at) %> ago</time>
        <% if event.ip_address %><span class="hidden sm:inline">· <%= event.ip_address %></span><% end %>
      </div>
    </li>
  <% end %>
<% end %>
