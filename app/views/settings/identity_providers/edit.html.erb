<% content_for :title, "#{@identity_provider.name_was} · #{current_tenant.name}" %>

<h1 class="text-2xl font-semibold"><%= @identity_provider.name_was %></h1>
<p class="mt-1 text-sm text-gray-600">
  <%= link_to "Identity providers", settings_identity_providers_path, class: "underline" %>
</p>

<section class="mt-8 rounded-lg border border-gray-200 bg-white p-6">
  <h2 class="text-sm font-semibold">Set up in your identity provider</h2>
  <p class="mt-1 text-sm text-gray-500">
    <% if @identity_provider.saml? %>
      Create a SAML application with these details, or upload the metadata.
    <% else %>
      Create an OIDC web application (authorization code flow) with this redirect URL.
    <% end %>
    They use this address, <span class="font-mono"><%= request.host %></span>, so people must sign in here.
  </p>

  <dl class="mt-4 space-y-3 text-sm">
    <% sp_details = if @identity_provider.saml?
         {
           "Assertion consumer service (ACS) URL" => @identity_provider.redirect_url(request.base_url),
           "Entity ID (audience)" => @identity_provider.saml_metadata_url(request.base_url),
           "Metadata URL" => @identity_provider.saml_metadata_url(request.base_url)
         }
       else
         { "Redirect URL" => @identity_provider.redirect_url(request.base_url) }
       end %>
    <% sp_details.each do |label, value| %>
      <div>
        <dt class="font-medium text-gray-900"><%= label %></dt>
        <dd class="mt-1 rounded bg-gray-50 px-3 py-2 font-mono text-xs break-all"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <% if @identity_provider.saml? %>
    <p class="mt-3 text-xs text-gray-500">Send the user's email address as the NameID or an <span class="font-mono">email</span> attribute.</p>
  <% end %>
</section>

<%= render "form", identity_provider: @identity_provider %>
